# Copy this file to `.env` and fill in secrets. Do NOT commit your `.env` file.

# LiveKit credentials
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google/Gemini (optional) - comma-separated keys
GEMINI_API_KEYS=

# OpenAI-compatible key (used by plugins). If `GEMINI_API_KEYS` is set, the agent may
# select one and export it as OPENAI_API_KEY at runtime.
OPENAI_API_KEY=

# Mem0
MEM0_API_KEY=

# Gmail (for send_email tool)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# MCP server used by MCPServerSse
N8N_MCP_SERVER_URL=
