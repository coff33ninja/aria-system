# Copy this file to `.env` and fill in secrets. Do NOT commit your `.env` file.

# LiveKit credentials
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM Provider: "openai" or "google"
# - openai: Requires OPENAI_API_KEY
# - google: Uses GEMINI_API_KEYS (with key rotation)
LLM_PROVIDER=openai

# Google/Gemini (optional) - comma-separated keys for rotation
GEMINI_API_KEYS=

# OpenAI API key (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Aria's local memory (optional - defaults shown)
# ARIA_MEMORY_FILE=./data/aria-memory.json
# ARIA_USER_NAME=Master
# ARIA_USE_MCP_MEMORY=true  # Set to "false" to use simple JSON fallback

# Voice handoff settings
# Set to "true" to force disconnect/reconnect when switching maid voices
# Use this if voice doesn't change with normal agent swap
# ARIA_FORCE_VOICE_RECONNECT=false

# Gmail (for send_email tool)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# MCP server used by MCPServerSse (optional)
N8N_MCP_SERVER_URL=
